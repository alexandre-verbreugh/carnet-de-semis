<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#3b6d11">
        <title>{% block title %}Carnet de semis{% endblock %}</title>

        <link rel="manifest" href="{{ asset('manifest.json') }}">
        <link rel="apple-touch-icon" href="{{ asset('images/icon-192.png') }}">
        <link rel="icon" href="{{ asset('images/icon-192.png') }}">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            <script src="{{ asset('js/app.js') }}" defer></script>
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% if app.user %}
            <header class="app-header">
                <div class="app-header__bar">
                    <a class="app-header__brand" href="{{ path('app_dashboard') }}">
                        <span class="app-header__logo" aria-hidden="true">🌱</span>
                        Carnet de semis
                    </a>

                    <button type="button"
                            class="app-header__burger"
                            data-nav-button
                            aria-expanded="false"
                            aria-controls="main-nav"
                            aria-label="Ouvrir le menu">
                        <span class="app-header__burger-bar" aria-hidden="true"></span>
                        <span class="app-header__burger-bar" aria-hidden="true"></span>
                        <span class="app-header__burger-bar" aria-hidden="true"></span>
                    </button>

                    <nav id="main-nav" class="app-nav" data-nav-menu>
                        {% set nav_items = [
                            { route: 'app_dashboard',  label: 'Tableau de bord' },
                            { route: 'app_sowing_index',   label: 'Semis' },
                            { route: 'app_plot_index',    label: 'Emplacements' },
                            { route: 'app_species_index',  label: 'Espèces' },
                            { route: 'app_calendar',       label: 'Calendrier' },
                            { route: 'app_seed_lot_index', label: 'Graines' },
                            { route: 'app_stats',          label: 'Statistiques' },
                        ] %}

                        <ul class="app-nav__list">
                            {% for item in nav_items %}
                                {% if route_exists(item.route) %}
                                    <li>
                                        <a href="{{ path(item.route) }}"
                                           class="app-nav__link{{ app.request.attributes.get('_route') == item.route ? ' is-active' : '' }}"
                                           {{ app.request.attributes.get('_route') == item.route ? 'aria-current="page"' : '' }}>
                                            {{ item.label }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                            <li class="app-nav__spacer"></li>
                            <li>
                                <a href="{{ path('app_logout') }}" class="app-nav__link app-nav__link--muted">Déconnexion</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </header>
        {% endif %}

        <main class="app-main">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <p class="flash flash--{{ label }}" role="status">{{ message }}</p>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% if app.user %}
            {% block floating_action %}
                {% if route_exists('app_observation_new') %}
                    <a class="fab" href="{{ path('app_observation_new') }}" aria-label="Ajouter une observation">
                        <span aria-hidden="true">📷</span>
                    </a>
                {% endif %}
            {% endblock %}
        {% endif %}
    </body>
</html>
