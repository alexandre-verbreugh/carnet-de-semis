{{ form_start(form) }}
    {% if not form.vars.valid %}
        <p class="flash flash--error" role="alert">
            Le formulaire contient des erreurs, elles sont signalées sous les champs concernés.
        </p>
        {{ form_errors(form) }}
    {% endif %}

    <div class="card">
        {{ form_row(form.name) }}
        {{ form_row(form.type) }}
        {{ form_row(form.shelter) }}
        {{ form_row(form.location) }}
        {{ form_row(form.exposure) }}
    </div>

    <div class="card">
        <p class="card__title">Dimensions</p>
        {{ form_row(form.lengthCm) }}
        {{ form_row(form.widthCm) }}
        {{ form_row(form.depthCm) }}
        {{ form_row(form.hasDrainage) }}
    </div>

    <div class="card">
        <p class="card__title">Substrat</p>
        {{ form_row(form.substrateComponents) }}
        {{ form_row(form.topLayer) }}
        {{ form_row(form.substrateNote) }}
        {{ form_row(form.filledAt) }}
    </div>

    {% if form.isArchived is defined and bouton != 'Créer' %}
        <div class="card">{{ form_row(form.isArchived) }}</div>
    {% else %}
        {% do form.isArchived.setRendered %}
    {% endif %}

    <button type="submit" class="btn btn--primary btn--block">{{ bouton }}</button>
{{ form_end(form) }}
